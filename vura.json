{
  "headers": [
    {
      "source": "/",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "source": "/plants/(.*)",
      "headers": {
        "Cache-Control": "private, no-store"
      }
    },
    {
      "source": "/catalog",
      "headers": {
        "Cache-Control": "private, no-store"
      }
    },
    {
      "source": "/journal",
      "headers": {
        "Cache-Control": "private, no-store"
      }
    },
    {
      "source": "/build",
      "headers": {
        "Cache-Control": "public, max-age=600"
      }
    }
  ]
}
